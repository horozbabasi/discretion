# Dependencies
node_modules/

# Build output
dist/
build/
*.tsbuildinfo

# Test coverage
coverage/

# Environment
.env
.env.*
!.env.example

# OS noise
.DS_Store
._*
Thumbs.db
ehthumbs.db
# Windows/OneDrive folder metadata — this checkout can live inside a synced
# folder, where Explorer creates these automatically.
[Dd]esktop.ini
$RECYCLE.BIN/

# Editor local state
.idea/
.vscode/*
!.vscode/extensions.json

# Local agent tooling — developer-local, not project content (ARCHITECTURE.md D6)
.claude/

# Logs
*.log
npm-debug.log*
.hf-cache/

# Gazetteer build working directory (build-time downloads)
.gazetteer-build/

# Loadable extension bundle (build output; dist/ holds tsc declarations)
packages/extension/build/

# Live-probe bundle and its browser profile (dev tool; never shipped)
packages/extension/.probe/

# Benchmark-local copy of the onnxruntime binaries (77 MB; copied from
# node_modules so the harness measures the same bytes the extension ships).
bench/wasm-latency/public/

# Python bytecode from the benchmark helpers.
__pycache__/
*.pyc

# Live-verification output (regenerated by the scripts that write it).
verify-all.log
probe*.log

# Live-verification browser profile: holds session cookies for the logged-in
# write-back check (ARCHITECTURE.md D43a). Never committed.
packages/extension/.live-profile/
live.log

# Store submission packages. Built by scripts/make-store-zip.sh from build/,
# which is itself generated. ~235 MB, almost all model weights - never commit.
packages/extension/*.zip
