{
  "name": "discretion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Discretion monorepo \u2014 local-first PII detection and masking",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace @discretion/web && npm run build --workspace @discretion/extension",
    "build:ts": "tsc -b",
    "typecheck": "tsc -b --force && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "bench": "tsc -b && node packages/core/dist/bench/normalization.bench.js",
    "eval": "tsc -b && node packages/eval/dist/cli.js",
    "web:dev": "npm run dev --workspace @discretion/web",
    "web:build": "npm run build --workspace @discretion/web",
    "web:preview": "npm run preview --workspace @discretion/web",
    "ext:build": "npm run build --workspace @discretion/extension",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "ext:fetch-model": "node packages/extension/scripts/fetch-model.mjs",
    "docs:api": "typedoc",
    "verify:consumer": "bash packages/core/scripts/verify-standalone-consumer.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/chrome": "^0.2.7",
    "@types/node": "^24.13.3",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fast-check": "^3.23.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "protobufjs@7.6.5": true
  }
}
