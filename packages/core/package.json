{
  "name": "@discretion/core",
  "version": "0.1.1",
  "type": "module",
  "description": "Local-first detection and masking of PII, credentials and secrets in text. No network access, no DOM, no Node built-ins.",
  "keywords": [
    "pii",
    "redaction",
    "masking",
    "anonymization",
    "gdpr",
    "secret-detection",
    "data-loss-prevention",
    "privacy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horozbabasi/discretion.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/horozbabasi/discretion/tree/main/packages/core#readme",
  "bugs": "https://github.com/horozbabasi/discretion/issues",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": true,
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./ner-transformers": {
      "types": "./dist/src/ner/transformersClassifier.d.ts",
      "default": "./dist/src/ner/transformersClassifier.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@discretion/data": "0.1.1",
    "libphonenumber-js": "^1.13.11"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0"
  }
}
