{
  "name": "@discretion/data",
  "version": "0.1.1",
  "type": "module",
  "description": "Generated data tables for @discretion/core: Unicode confusables, trigger lexicons, gazetteers, severity weights, and the fitted calibration model.",
  "keywords": [
    "discretion",
    "unicode",
    "confusables",
    "gazetteer"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/horozbabasi/discretion.git",
    "directory": "packages/data"
  },
  "homepage": "https://github.com/horozbabasi/discretion/tree/main/packages/data#readme",
  "bugs": "https://github.com/horozbabasi/discretion/issues",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "generate": "node scripts/build-confusables.ts"
  }
}
